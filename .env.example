# ─────────────────────────────────────────────────────────────────────────────
# Jepco Engine — plantilla de variables de entorno
#
# Copiar a `.env` y rellenar. La referencia completa está en DEPLOYMENT.md.
# NUNCA subir el `.env` real al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── Imprescindibles ──────────────────────────────────────────────────────────

# PostgreSQL con la extensión pgvector habilitada
DATABASE_URL=postgresql://usuario:contrasena@host:5432/basededatos

# Clave de la API de Google Gemini
GEMINI_API_KEY=

# Secreto de los endpoints de administración e ingesta.
# Generar con: openssl rand -hex 32
UPLOAD_SECRET=

# ── Seguridad ────────────────────────────────────────────────────────────────

# Dominios autorizados a llamar a /api/*, separados por coma.
# Admite origen exacto y comodín de subdominio:
#   CORS_ORIGINS=https://app.snfplus.com,*.snfplus.com
#
# '*' permite cualquier origen — SOLO para desarrollo local.
CORS_ORIGINS=*

# Peticiones por minuto y por IP
RATE_LIMIT_MAX=30
RATE_LIMIT_GLOBAL_MAX=120

# ── Panel de administración (/admin) ─────────────────────────────────────────

# Cuentas nominales, separadas por coma:  usuario:salt:hash,otro:salt:hash
# Generar cada una con:  node scratch/admin-user.js <usuario>
#
# Sin esta variable el panel queda deshabilitado y responde 503.
# Son cuentas por persona a propósito: detrás del panel hay conversaciones de
# empleados, y con una llave compartida no se puede saber quién accedió.
ADMIN_USERS=

# ── Telegram: avisos de escalado a humano ────────────────────────────────────

# Sin estas dos, el escalado funciona de cara al usuario pero nadie recibe aviso
ADMIN_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=

# Bots por perfil (opcionales — solo si se atiende también desde Telegram)
SNFPLUS_USUARIO_BOT_TOKEN=
SNFPLUS_RRHH_BOT_TOKEN=
SNFPLUS_GESTOR_BOT_TOKEN=

# ── Otras marcas ─────────────────────────────────────────────────────────────

SALUDFLEX_BOT_TOKEN=
VEGANFOOD_BOT_TOKEN=
DOMAINHUNTER_BOT_TOKEN=

# ── Local ────────────────────────────────────────────────────────────────────

# Railway inyecta PORT automáticamente; solo hace falta en local
PORT=3000
